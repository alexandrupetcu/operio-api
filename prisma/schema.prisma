generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenancy ──────────────────────────────────────────────────────────

model Tenant {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  address        String?
  phone          String?
  email          String?
  cui            String?
  regCom         String?
  isVatPayer     Boolean  @default(false)
  adminName      String?
  iscirNumber    String? // ex: "89C - 689"
  iscirDate      String? // ex: "12.07.2023"
  stampS3Key     String?
  signatureS3Key String?
  logoS3Key      String?
  timezone       String   @default("Europe/Bucharest")
  locale         String   @default("ro")
  settingsJson   Json?
  brandingJson   Json?
  countryId      Int?
  country        Country? @relation(fields: [countryId], references: [id])
  stateId        Int?
  state          State?   @relation(fields: [stateId], references: [id])
  cityId         Int?
  city           City?    @relation(fields: [cityId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users                   User[]
  clients                 Client[]
  projects                Project[]
  projectTypes            ProjectType[]
  distributors            Distributor[]
  fieldPresets            FieldPreset[]
  documents               Document[]
  documentTemplates       DocumentTemplate[]
  services                Service[]
  employees               Employee[]
  vehicles                Vehicle[]
  workflowDefinitions     WorkflowDefinition[]
  workflowInstances       WorkflowInstance[]
  tasks                   Task[]
  scheduledJobs           ScheduledJob[]
  notifications           Notification[]
  notificationTemplates   NotificationTemplate[]
  notificationPreferences NotificationPreference[]
  webPushSubscriptions    WebPushSubscription[]
  pushDevices             PushDevice[]
  mobileDevices           MobileDevice[]
  auditLogs               AuditLog[]
  outboxEvents            OutboxEvent[]
  drawingTemplates        DrawingTemplate[]
  signingSessions         SigningSession[]
  appointments            Appointment[]
  emailInboxes            EmailInbox[]
  emailIngestionEnabled   Boolean                  @default(false)
  registrySeries          RegistrySeries[]
  registryEntries         RegistryEntry[]
  emailIngestLogs         EmailIngestLog[]
  actionFeedStates        ActionFeedState[]
  actionFeedSnoozeNotes   ActionFeedSnoozeNote[]

  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  // Explicit opt-in for the technician mobile app (see MobileDevice).
  mobileAccess Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  documents               Document[]
  createdWorkflows        WorkflowDefinition[]     @relation("WorkflowCreatedBy")
  assignedStepInstances   WorkflowStepInstance[]   @relation("StepAssignedUser")
  assignedTasks           Task[]                   @relation("TaskAssignedUser")
  auditLogs               AuditLog[]
  signingSessions         SigningSession[]
  createdRegistryEntries  RegistryEntry[]          @relation("RegistryCreator")
  voidedRegistryEntries   RegistryEntry[]          @relation("RegistryVoider")
  notificationPreferences NotificationPreference[]
  webPushSubscriptions    WebPushSubscription[]
  pushDevices             PushDevice[]
  mobileDevices           MobileDevice[]
  revokedMobileDevices    MobileDevice[]           @relation("MobileDeviceRevokedBy")
  employee                Employee?

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum Role {
  MASTER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  // Which client the session was opened from; carried into every access token
  // minted from this refresh token. Mobile sessions are bound to a device.
  client    String   @default("web") // web | mobile
  deviceId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// Single-use password-reset token. The `tokenHash` is SHA-256 of the random
// value emailed to the user — DB compromise doesn't leak working tokens.
// Lookups happen by hash. `usedAt` marks single-use consumption so a leaked
// reset link can't be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Business Domain ────────────────────────────────────────────────────────

enum ClientType {
  PERSON
  COMPANY
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

model Client {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  type        ClientType
  status      ClientStatus @default(PROSPECT)
  companyName String?
  cui         String?
  firstName   String?
  lastName    String?
  phone       String?
  email       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  addresses        ClientAddress[]
  projects         Project[]
  contactPersons   ContactPerson[]
  equipment        Equipment[]
  documents        ClientDocument[]
  tasks            Task[]
  notifications    Notification[]
  appointments     Appointment[]
  registryEntries  RegistryEntry[]
  gasInstallations GasInstallation[]

  @@index([tenantId])
}

model ClientAddress {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label     String?
  address   String
  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id])
  stateId   Int?
  state     State?   @relation(fields: [stateId], references: [id])
  cityId    Int?
  city      City?    @relation(fields: [cityId], references: [id])
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment        Equipment[]
  gasInstallations GasInstallation[]
  appointments     Appointment[]

  @@index([clientId])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
}

model ContactPerson {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum EquipmentType {
  CENTRALA
}

model Equipment {
  id              String              @id @default(cuid())
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientAddressId String?
  clientAddress   ClientAddress?      @relation(fields: [clientAddressId], references: [id], onDelete: SetNull)
  type            EquipmentType       @default(CENTRALA)
  name            String?
  internalName    String?
  fuel            String?
  serial          String?
  deviceType      String? // MURALA, STATIV, etc.
  power           String? // KW, ex: "24"
  airSupply       String? // aspirat | insuflat
  feeding         String? // manuala | automata
  location        String? // BUCATARIE, CENTRALA TERMICA
  fuelIscir       String? // G20, G25, etc.
  deviceAge       String? // nou | vechi
  revisions       EquipmentRevision[]
  appointments    Appointment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([clientId])
  @@index([clientAddressId])
}

model EquipmentRevision {
  id                 String    @id @default(cuid())
  equipmentId        String
  equipment          Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  revisionDate       DateTime
  status             String    @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  s3Key              String?
  fileName           String?
  operatorName       String?
  operatorAddress    String?
  operatorPhone      String?
  operatorEmail      String?
  analyzerName       String?
  analyzerSerial     String?
  location           String?
  pdfEquipmentName   String?
  pdfEquipmentSerial String?
  pdfClientAddress   String?
  analysisData       Json?
  rawText            String?   @db.Text
  notes              String?   @db.Text
  sourceEmailId      String?
  iscirDocumentId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointment Appointment?

  @@index([equipmentId])
  @@index([equipmentId, revisionDate])
}

// Gas installation (instalație de utilizare gaze naturale) — reusable identity
// for revizie/verificare appointments: distributor (OS), cod tehnic/POD, cod
// client, service contract, gas meter (contor) + sealing, consumer appliances.
// Scoped via the client (like Equipment). Filled once, reused across visits.
model GasInstallation {
  id               String         @id @default(cuid())
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientAddressId  String?
  clientAddress    ClientAddress? @relation(fields: [clientAddressId], references: [id], onDelete: SetNull)
  label            String?
  distributorName  String? // Operator de sistem (OS), ex. "DISTRIGAZ SUD RETELE"
  codTehnicPOD     String? // Cod tehnic / POD, ex. "DGSBUSC20000641408"
  codClient        String? // Cod client, ex. "191093362488"
  contractNumber   String? // Contract prestări servicii, ex. "234 V-R"
  contractDate     String? // ex. "18.05.2026"
  documentatieNr   String? // Documentația tehnică nr.
  documentatieData String? // Documentația tehnică data (or "nu detine")
  contorTip        String? // ex. "BK-G4 MT"
  contorSeria      String? // ex. "DGSR"
  contorNr         String? // ex. "04110636"
  contorAn         String? // ex. "2023"
  contorIndex      String? // ex. "00717,60 mc"
  appliancesJson   Json? // [{ kind: "CT"|"MA", name, debit, count }]
  appointments     Appointment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([clientId])
  @@index([clientAddressId])
}

// ─── Project Types (configurable per tenant) ────────────────────────────────

model ProjectType {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  code         String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  metadataJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects            Project[]
  workflowDefinitions WorkflowDefinition[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// ─── Field presets ─────────────────────────────────────────────────────────

/**
 * Vocabularul repetitiv din formularele de teren (material, furnizor, diametru,
 * tip contor…), îmbogățit cu ce scriu operatorii, ca valoarea introdusă de unul
 * să apară la toți ceilalți din firmă.
 * `normalized` (trim + spații colapsate + lowercase) ține unicitatea, ca „Valrom
 * SRL", „valrom srl" și „ Valrom  SRL " să fie o singură intrare; `useCount`
 * ordonează lista, ca valorile folosite des să urce, iar cele scrise o dată din
 * greșeală să cadă la coadă.
 */
model FieldPreset {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  scope      String // cheia vocabularului: material, furnizor, diamTeava, diamArm, contorTip, certificat, aparat
  value      String // forma afișată, așa cum a scris-o operatorul
  normalized String // forma de comparație (lowercase)
  useCount   Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, scope, normalized])
  @@index([tenantId, scope])
}

// ─── Distributors ──────────────────────────────────────────────────────────

model Distributor {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String
  name        String
  contactJson Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects            Project[]
  workflowDefinitions WorkflowDefinition[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

// ─── Projects ───────────────────────────────────────────────────────────────

model Project {
  id                        String            @id @default(cuid())
  tenantId                  String
  tenant                    Tenant            @relation(fields: [tenantId], references: [id])
  clientId                  String
  client                    Client            @relation(fields: [clientId], references: [id])
  projectTypeId             String
  projectType               ProjectType       @relation(fields: [projectTypeId], references: [id])
  distributorId             String?
  distributor               Distributor?      @relation(fields: [distributorId], references: [id])
  name                      String
  address                   String
  city                      String
  county                    String
  observations              String?
  participareISC            Boolean           @default(false)
  status                    String            @default("draft")
  priority                  String            @default("normal")
  // "project" = normal full-workflow project (default — every pre-existing row)
  // "quick_dossier" = lightweight client-level generation flow (no workflow, no
  // scheduling); hidden from the regular projects list, surfaced only on the
  // client detail page via the ClientDossiersCard.
  kind                      String            @default("project")
  // For kind = "quick_dossier" — points at the DocumentTemplate group the user
  // picked. Lets the client UI know which template set to render + lets the
  // generate endpoint look up the right category.
  templateGroupId           String?
  templateGroup             DocumentTemplate? @relation("QuickDossierGroup", fields: [templateGroupId], references: [id])
  metadata                  Json?
  scheduledDate             DateTime?
  assignedEmployeeId        String?
  assignedEmployee          Employee?         @relation(fields: [assignedEmployeeId], references: [id])
  currentWorkflowInstanceId String?
  drawingS3Key              String?
  drawingJson               Json?
  openedAt                  DateTime          @default(now())
  closedAt                  DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  documents         ProjectDocument[]
  workflowInstances WorkflowInstance[]
  tasks             Task[]
  notifications     Notification[]
  teamMembers       ProjectTeamMember[]
  appointments      Appointment[]
  registryEntries   RegistryEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, projectTypeId])
  @@index([tenantId, distributorId])
  @@index([clientId])
  @@index([tenantId, assignedEmployeeId])
}

// ─── Project Team Members ──────────────────────────────────────────────

model ProjectTeamMember {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  role        String
  name        String
  credentials Json?
  createdAt   DateTime  @default(now())

  @@index([projectId, role])
  @@index([projectId])
}

// ─── Documents ──────────────────────────────────────────────────────────────

model TemplateCategory {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  description        String?
  icon               String? // lucide icon name
  color              String? // tailwind color (e.g. "blue", "amber")
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  // Registry series (RegistrySeries.code) used when auto-numbering documents of
  // this category. Null → falls back to "iesiri". Lets each operation type get
  // its own series (Registratură dinamică).
  registrySeriesCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  templates DocumentTemplate[]
}

model DocumentTemplate {
  id           String           @id @default(cuid())
  tenantId     String?
  tenant       Tenant?          @relation(fields: [tenantId], references: [id])
  categoryCode String
  category     TemplateCategory @relation(fields: [categoryCode], references: [code])
  name         String
  description  String?
  content      String?          @db.Text
  s3Key        String?
  fileName     String? // editable display/download filename (DOCX members); falls back to the s3Key segment
  type         String           @default("single") // "single" (HTML or DOCX) | "group" (bundle of DOCX members)
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // DOCX Group: a "group" parent owns ordered "single" DOCX members.
  parentGroupId        String?
  parentGroup          DocumentTemplate?  @relation("GroupMembers", fields: [parentGroupId], references: [id], onDelete: Cascade)
  groupMembers         DocumentTemplate[] @relation("GroupMembers")
  // Quick-dossier projects seeded from this group template (kind="quick_dossier").
  quickDossierProjects Project[]          @relation("QuickDossierGroup")
  memberOrder          Int                @default(0)

  documents Document[]

  @@index([tenantId, categoryCode])
  @@index([parentGroupId, memberOrder])
}

enum DocumentStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  UPLOADED
  SIGNING
  SIGNED
}

enum SigningStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum SignatoryStatus {
  PENDING
  SIGNED
  DECLINED
}

model Document {
  id                     String                @id @default(cuid())
  tenantId               String
  tenant                 Tenant                @relation(fields: [tenantId], references: [id])
  templateId             String?
  template               DocumentTemplate?     @relation(fields: [templateId], references: [id])
  generatedById          String?
  generatedBy            User?                 @relation(fields: [generatedById], references: [id])
  workflowStepInstanceId String?
  workflowStepInstance   WorkflowStepInstance? @relation(fields: [workflowStepInstanceId], references: [id])
  name                   String
  s3Key                  String?
  status                 DocumentStatus        @default(PENDING)
  errorMessage           String?
  contextJson            Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  projects        ProjectDocument[]
  clients         ClientDocument[]
  signingSessions SigningSession[]
  registryEntries RegistryEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, workflowStepInstanceId])
}

model ProjectDocument {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([projectId, documentId])
  @@index([projectId])
  @@index([documentId])
}

model ClientDocument {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([clientId, documentId])
  @@index([clientId])
  @@index([documentId])
}

// ─── Document Signing ────────────────────────────────────────────────────────

model SigningSession {
  id                  String        @id @default(cuid())
  tenantId            String
  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  documentId          String
  document            Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdById         String
  createdBy           User          @relation(fields: [createdById], references: [id])
  status              SigningStatus @default(DRAFT)
  message             String?
  documentHash        String // SHA-256 hash of the PDF at session creation
  expiresAt           DateTime
  completedAt         DateTime?
  signedDocumentS3Key String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  signatories Signatory[]
  events      SigningEvent[]

  @@index([tenantId])
  @@index([documentId])
}

model Signatory {
  id               String          @id @default(cuid())
  signingSessionId String
  signingSession   SigningSession  @relation(fields: [signingSessionId], references: [id], onDelete: Cascade)
  name             String
  email            String
  phone            String?
  role             String
  signOrder        Int
  token            String          @unique @default(cuid())
  status           SignatoryStatus @default(PENDING)
  signatureS3Key   String?
  signedAt         DateTime?
  declinedAt       DateTime?
  declineReason    String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  events SigningEvent[]

  @@index([signingSessionId])
  @@index([token])
}

model SigningEvent {
  id               String         @id @default(cuid())
  signingSessionId String
  signingSession   SigningSession @relation(fields: [signingSessionId], references: [id], onDelete: Cascade)
  signatoryId      String?
  signatory        Signatory?     @relation(fields: [signatoryId], references: [id], onDelete: Cascade)
  eventType        String // SESSION_CREATED, INVITATION_SENT, DOCUMENT_VIEWED, SIGNATURE_SUBMITTED, SIGNATURE_DECLINED, SESSION_COMPLETED, SESSION_CANCELLED, SESSION_EXPIRED, REMINDER_SENT
  documentHash     String // SHA-256 hash of the PDF at event time
  ipAddress        String?
  userAgent        String?
  metadata         Json?
  createdAt        DateTime       @default(now())

  @@index([signingSessionId])
  @@index([signatoryId])
  @@index([eventType])
  @@index([createdAt])
}

// ─── Fleet & Staff ──────────────────────────────────────────────────────────

model Vehicle {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  licensePlate    String
  make            String
  model           String
  year            Int?
  vin             String?
  fuelType        String?
  avgKmPerMonth   Int?
  // Expiry dates
  itpExpiry       DateTime?
  insuranceExpiry DateTime?
  vignetteExpiry  DateTime?
  // Document S3 keys
  talonS3Key      String?
  civS3Key        String?
  rcaS3Key        String?
  vignetteS3Key   String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  revisions     VehicleRevision[]
  notifications Notification[]
  appointments  Appointment[]

  @@index([tenantId])
}

model VehicleRevision {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  km        Int
  notes     String?
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model Employee {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  firstName      String
  lastName       String
  employeeType   String   @default("intern") // intern | colaborator
  position       String? // instalator, proiectant, rte, diriginte, verificator, sudor
  phone          String?
  email          String?
  credentials    Json?
  signatureS3Key String?
  isActive       Boolean  @default(true)
  // Contul de aplicație al acestei persoane, când există. Legătura stă aici, nu pe
  // User, pentru că Employee are tenantId obligatoriu (User.tenantId e nullable
  // pentru MASTER_ADMIN), iar colaboratorii fără cont rămân natural userId = null.
  // @unique pe coloană nullable permite oricâte NULL-uri, deci impune 1:1 fără backfill.
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects        Project[]
  teamAssignments ProjectTeamMember[]
  appointments    Appointment[]

  @@index([tenantId])
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  unit        String?
  price       Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// ─── Geography ──────────────────────────────────────────────────────────────

model Country {
  id             Int      @id
  name           String
  iso3           String   @unique @db.Char(3)
  iso2           String   @unique @db.Char(2)
  numericCode    String?
  phonecode      String?
  capital        String?
  currency       String?
  currencyName   String?
  currencySymbol String?
  tld            String?
  native         String?
  region         String?
  subregion      String?
  nationality    String?
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)
  emoji          String?
  emojiU         String?

  states          State[]
  cities          City[]
  clientAddresses ClientAddress[]
  tenants         Tenant[]

  @@index([name])
}

model State {
  id          Int      @id
  name        String
  countryId   Int
  country     Country  @relation(fields: [countryId], references: [id])
  countryCode String   @db.Char(2)
  stateCode   String?
  type        String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)

  cities          City[]
  clientAddresses ClientAddress[]
  tenants         Tenant[]

  @@index([countryId])
  @@index([name])
}

model City {
  id          Int      @id
  name        String
  stateId     Int
  state       State    @relation(fields: [stateId], references: [id])
  countryId   Int
  country     Country  @relation(fields: [countryId], references: [id])
  countryCode String   @db.Char(2)
  stateCode   String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)

  clientAddresses ClientAddress[]
  tenants         Tenant[]

  @@index([stateId])
  @@index([countryId])
  @@index([name])
}

// ─── Workflow Definition Layer ──────────────────────────────────────────────

model WorkflowDefinition {
  id                 String               @id @default(cuid())
  tenantId           String?
  tenant             Tenant?              @relation(fields: [tenantId], references: [id])
  baseDefinitionId   String?
  baseDefinition     WorkflowDefinition?  @relation("WorkflowInheritance", fields: [baseDefinitionId], references: [id])
  derivedDefinitions WorkflowDefinition[] @relation("WorkflowInheritance")
  projectTypeId      String?
  projectType        ProjectType?         @relation(fields: [projectTypeId], references: [id])
  distributorId      String?
  distributor        Distributor?         @relation(fields: [distributorId], references: [id])
  role               String               @default("primary") // "primary" (attached to projects) | "secondary" (callable as sub-workflow only)
  code               String
  name               String
  entityType         String               @default("project")
  version            Int                  @default(1)
  status             String               @default("draft") // draft, published, archived
  description        String?
  category           String? // "general", "document_generation", "approval", etc.
  isActive           Boolean              @default(true)
  configJson         Json?
  publishedAt        DateTime?
  createdById        String?
  createdBy          User?                @relation("WorkflowCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  steps             WorkflowStep[]
  transitions       WorkflowTransition[]
  workflowInstances WorkflowInstance[]

  @@unique([tenantId, code, version])
  @@index([tenantId])
  @@index([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, projectTypeId])
  @@index([tenantId, distributorId])
  @@index([tenantId, role])
  @@index([tenantId, role, projectTypeId, distributorId])
  @@index([tenantId, isActive])
  @@index([tenantId, category])
  @@index([baseDefinitionId])
}

model WorkflowStep {
  id                   String             @id @default(cuid())
  tenantId             String?
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  code                 String
  name                 String
  stepType             String             @default("human_task") // human_task, timer_wait, decision, document_generation, notification, approval, system_action, final
  orderIndex           Int                @default(0)
  isStart              Boolean            @default(false)
  isTerminal           Boolean            @default(false)
  joinMode             String? // null (default), "all" (wait for all spawned siblings), "any" (continue on first)
  nameTemplate         String? // e.g. "Depune cerere la {{filing.institution}}" — resolved per-instance at runtime
  configJson           Json?
  formSchemaJson       Json?
  validationSchemaJson Json?
  uiSchemaJson         Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  outgoingTransitions WorkflowTransition[]   @relation("TransitionFrom")
  incomingTransitions WorkflowTransition[]   @relation("TransitionTo")
  actions             WorkflowStepAction[]
  stepInstances       WorkflowStepInstance[]

  @@unique([workflowDefinitionId, code])
  @@index([tenantId])
  @@index([workflowDefinitionId])
  @@index([workflowDefinitionId, orderIndex])
  @@index([workflowDefinitionId, stepType])
  @@index([workflowDefinitionId, isStart])
  @@index([workflowDefinitionId, isTerminal])
}

model WorkflowTransition {
  id                   String             @id @default(cuid())
  tenantId             String?
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  fromStepId           String
  fromStep             WorkflowStep       @relation("TransitionFrom", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStepId             String
  toStep               WorkflowStep       @relation("TransitionTo", fields: [toStepId], references: [id], onDelete: Cascade)
  transitionType       String             @default("default") // default, success, failure, timeout, conditional, manual
  label                String?
  priority             Int                @default(0)
  conditionJson        Json?
  configJson           Json?
  spawnMode            String             @default("single") // single (default), foreach (create N instances from array in output)
  foreachPath          String? // JSON path to array in step output, e.g. "required_filings"
  itemContextKey       String? // key name for each item in spawned step context, e.g. "filing"
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tenantId])
  @@index([workflowDefinitionId])
  @@index([workflowDefinitionId, fromStepId])
  @@index([workflowDefinitionId, toStepId])
  @@index([workflowDefinitionId, transitionType])
}

model WorkflowStepAction {
  id               String       @id @default(cuid())
  tenantId         String?
  stepId           String
  step             WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  triggerEvent     String // on_enter, on_complete, on_timeout, on_fail, on_field_change, on_file_upload
  actionType       String // create_task, schedule_timer, send_notification, ..., call_api
  targetFieldKey   String? // For frontend events: which form field triggers this listener
  actionConfigJson Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([tenantId])
  @@index([stepId])
  @@index([stepId, triggerEvent])
  @@index([stepId, actionType])
}

// ─── Workflow Runtime Layer ─────────────────────────────────────────────────

model WorkflowInstance {
  id                       String                @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                @relation(fields: [tenantId], references: [id])
  workflowDefinitionId     String
  workflowDefinition       WorkflowDefinition    @relation(fields: [workflowDefinitionId], references: [id])
  entityType               String                @default("project")
  entityId                 String
  project                  Project?              @relation(fields: [entityId], references: [id])
  status                   String                @default("running") // running, completed, failed, cancelled
  currentStepCode          String?
  contextJson              Json?
  startedAt                DateTime              @default(now())
  completedAt              DateTime?
  parentStepInstanceId     String?               @unique
  parentStepInstance       WorkflowStepInstance? @relation("SubWorkflowParent", fields: [parentStepInstanceId], references: [id])
  parentWorkflowInstanceId String?
  parentWorkflowInstance   WorkflowInstance?     @relation("SubWorkflowParentWf", fields: [parentWorkflowInstanceId], references: [id])
  childWorkflowInstances   WorkflowInstance[]    @relation("SubWorkflowParentWf")
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  stepInstances WorkflowStepInstance[]
  executionLogs WorkflowExecutionLog[]
  tasks         Task[]
  notifications Notification[]

  @@index([tenantId])
  @@index([tenantId, workflowDefinitionId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, entityType, entityId, parentWorkflowInstanceId])
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
  @@index([parentWorkflowInstanceId])
}

model WorkflowStepInstance {
  id                 String           @id @default(cuid())
  tenantId           String
  workflowInstanceId String
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  stepDefinitionId   String? // null == ad-hoc step, instance-local (not in the definition graph)
  stepDefinition     WorkflowStep?    @relation(fields: [stepDefinitionId], references: [id])
  status             String           @default("pending") // pending, active, waiting, completed, failed, cancelled, skipped, overdue
  availableAt        DateTime?
  dueAt              DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  assignedUserId     String?
  assignedUser       User?            @relation("StepAssignedUser", fields: [assignedUserId], references: [id])
  outputJson         Json?
  errorJson          Json?
  retryCount         Int              @default(0)
  displayName        String? // resolved name template (e.g. "Depune cerere la ANAF") — null means use stepDefinition.name; for ad-hoc steps this IS the name
  spawnGroupId       String? // groups instances created by a foreach transition
  itemContextJson    Json? // per-item context data from foreach spawn
  isAdHoc            Boolean          @default(false) // true == manually-added instance-local step (stepDefinitionId is null)
  adHocStepType      String? // for ad-hoc steps; always "human_task" in v1
  formSchemaJson     Json? // optional inline form for ad-hoc steps (mirrors WorkflowStep.formSchemaJson)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  executionLogs         WorkflowExecutionLog[]
  tasks                 Task[]
  documents             Document[]
  childWorkflowInstance WorkflowInstance?      @relation("SubWorkflowParent")

  @@index([tenantId])
  @@index([tenantId, workflowInstanceId])
  @@index([tenantId, stepDefinitionId])
  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, availableAt])
  @@index([tenantId, dueAt])
  @@index([spawnGroupId])
  @@index([spawnGroupId, stepDefinitionId])
}

model WorkflowExecutionLog {
  id                 String                @id @default(cuid())
  tenantId           String
  workflowInstanceId String
  workflowInstance   WorkflowInstance      @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  stepInstanceId     String?
  stepInstance       WorkflowStepInstance? @relation(fields: [stepInstanceId], references: [id])
  eventType          String
  payloadJson        Json?
  createdAt          DateTime              @default(now())

  @@index([tenantId])
  @@index([tenantId, workflowInstanceId])
  @@index([tenantId, stepInstanceId])
  @@index([tenantId, eventType])
  @@index([createdAt])
}

// ─── Task Domain ────────────────────────────────────────────────────────────

model Task {
  id                     String                @id @default(cuid())
  tenantId               String
  tenant                 Tenant                @relation(fields: [tenantId], references: [id])
  projectId              String?
  project                Project?              @relation(fields: [projectId], references: [id])
  clientId               String?
  client                 Client?               @relation(fields: [clientId], references: [id])
  workflowInstanceId     String?
  workflowInstance       WorkflowInstance?     @relation(fields: [workflowInstanceId], references: [id])
  workflowStepInstanceId String?
  workflowStepInstance   WorkflowStepInstance? @relation(fields: [workflowStepInstanceId], references: [id])
  title                  String
  description            String?
  taskType               String                @default("manual") // manual, workflow_generated, followup
  status                 String                @default("open") // open, in_progress, done, cancelled, overdue
  priority               String                @default("normal") // low, normal, high, urgent
  assignedUserId         String?
  assignedUser           User?                 @relation("TaskAssignedUser", fields: [assignedUserId], references: [id])
  dueAt                  DateTime?
  completedAt            DateTime?
  metadataJson           Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  notifications Notification[]

  @@index([tenantId])
  @@index([tenantId, projectId])
  @@index([tenantId, clientId])
  @@index([tenantId, workflowInstanceId])
  @@index([tenantId, workflowStepInstanceId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, status])
  @@index([tenantId, dueAt])
  @@index([tenantId, deletedAt])
}

// ─── Notification Domain ────────────────────────────────────────────────────

model NotificationTemplate {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  code            String
  channel         String // in_app, email, sms, webhook
  subjectTemplate String?
  bodyTemplate    String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, code, channel])
  @@index([tenantId])
  @@index([tenantId, channel])
  @@index([tenantId, isActive])
}

model Notification {
  id                   String            @id @default(cuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id])
  userId               String?
  clientId             String?
  client               Client?           @relation(fields: [clientId], references: [id])
  projectId            String?
  project              Project?          @relation(fields: [projectId], references: [id])
  taskId               String?
  task                 Task?             @relation(fields: [taskId], references: [id])
  workflowInstanceId   String?
  workflowInstance     WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])
  vehicleId            String?
  vehicle              Vehicle?          @relation(fields: [vehicleId], references: [id])
  category             String? // projects, fleet, tasks, system
  channel              String // in_app, email, web_push, expo_push
  subject              String?
  body                 String
  status               String            @default("pending") // pending, scheduled, sent, failed, cancelled
  scheduledAt          DateTime?
  sentAt               DateTime?
  providerResponseJson Json?
  metadataJson         Json?
  // Idempotency key for the scheduled scanner: "due:<kind>:<id>:<yyyy-mm-dd>".
  // Prevents re-notifying the same user about the same item across re-runs.
  dedupeKey            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, clientId])
  @@index([tenantId, projectId])
  @@index([tenantId, taskId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, category])
  @@index([tenantId, channel])
  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, userId, dedupeKey])
}

// Per-user × category × channel opt-out. Absence of a row = enabled
// (default-on), so users only ever store their opt-outs.
model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  category  String // projects, fleet, tasks, system
  channel   String // in_app, email, web_push, expo_push
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, category, channel])
  @@index([tenantId, userId])
}

// Browser Web Push subscription (VAPID). One row per browser/device endpoint.
model WebPushSubscription {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([tenantId, userId])
}

// Mobile push token (Expo → APNs/FCM). One row per device. Governed by the same
// "push" preference as WebPushSubscription (channel web_push).
model PushDevice {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  expoToken  String   @unique
  platform   String? // ios | android
  deviceName String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([tenantId, userId])
}

/**
 * A phone that logged into the technician app. `deviceId` is the OS-level
 * app-scoped identifier (Android ID / iOS IDFV) sent at login; the first login
 * registers the device automatically, admins can revoke it afterwards.
 */
model MobileDevice {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  platform    String? // android | ios
  model       String? // e.g. "Samsung SM-A546B"
  name        String? // user-visible device name
  appVersion  String?
  status      String    @default("active") // active | revoked
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("MobileDeviceRevokedBy", fields: [revokedById], references: [id])

  @@unique([userId, deviceId])
  @@index([tenantId, userId])
}

// ─── Dashboard action-feed snooze/dismiss overlay ───────────────────────────
// Per-user "remind me later / resolved" state for the derived dashboard action
// feed. Self-invalidating: a row only suppresses an item while `conditionRef`
// (a snapshot of the underlying condition) still matches the live value.
// Tenant-wide overlay for the dashboard action-feed: a snooze/dismiss applied
// by any operator hides the item from the whole firm's active list. The
// `snoozedBy*` fields are a snapshot of the operator who placed it, so the UI
// can render "Amânat de X" without joining User on every read and surviving
// user deletions.
model ActionFeedState {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  actionKey     String // == feed item.id (e.g. "fleet-<vehicleId>", "task-<id>")
  kind          String // revision | fleet | task | project
  conditionRef  String // snapshot of the underlying condition at action time
  snoozedUntil  DateTime?
  dismissedAt   DateTime?
  reason        String?
  snoozedById   String?
  snoozedByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, actionKey])
  @@index([tenantId])
}

// Per-tenant audit log of every snooze, un-snooze, and dismiss event on an
// action-feed item. Visible to every operator viewing that item — so the next
// person who picks up the task can see the full call history ("am sunat la
// Raja, revin în 3 zile") plus who reactivated it and why.
model ActionFeedSnoozeNote {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  actionKey  String
  kind       String
  eventType  String    @default("snooze") // "snooze" | "unsnooze" | "dismiss"
  until      DateTime?
  note       String?
  authorId   String
  authorName String
  createdAt  DateTime  @default(now())

  @@index([tenantId, actionKey])
}

// ─── Automation Layer ───────────────────────────────────────────────────────

model ScheduledJob {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  jobType           String // activate_step, mark_step_overdue, send_notification, create_followup_project, generate_document, escalate_issue, recalculate_deadline
  relatedEntityType String?
  relatedEntityId   String?
  runAt             DateTime
  status            String    @default("pending") // pending, locked, processed, failed, cancelled
  payloadJson       Json?
  attempts          Int       @default(0)
  maxAttempts       Int       @default(10)
  lockedAt          DateTime?
  processedAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, jobType])
  @@index([tenantId, status])
  @@index([tenantId, runAt])
  @@index([status, runAt])
  @@index([tenantId, relatedEntityType, relatedEntityId])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  eventName     String
  aggregateType String
  aggregateId   String
  payloadJson   Json
  publishedAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, eventName])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([publishedAt])
  @@index([failedAt])
}

// ─── Audit Domain ───────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  actorUserId  String?
  actorUser    User?    @relation(fields: [actorUserId], references: [id])
  entityType   String
  entityId     String
  action       String
  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, actorUserId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action])
  @@index([createdAt])
}

model DrawingTemplate {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  name       String
  canvasJson Json
  isGlobal   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([isGlobal])
}

// ─── Appointments ──────────────────────────────────────────────────────

model Appointment {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  projectId           String?
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?            @relation(fields: [clientId], references: [id])
  clientAddressId     String?
  clientAddress       ClientAddress?     @relation(fields: [clientAddressId], references: [id], onDelete: SetNull)
  employeeId          String?
  employee            Employee?          @relation(fields: [employeeId], references: [id])
  equipmentId         String?
  equipment           Equipment?         @relation(fields: [equipmentId], references: [id])
  equipmentRevisionId String?            @unique
  equipmentRevision   EquipmentRevision? @relation(fields: [equipmentRevisionId], references: [id])
  installationId      String?
  installation        GasInstallation?   @relation(fields: [installationId], references: [id])
  vehicleId           String?
  vehicle             Vehicle?           @relation(fields: [vehicleId], references: [id])
  type                String             @default("general") // general, revizie, ridicare_documente, revizie_instalatie, verificare_instalatie, itp, rca
  title               String
  notes               String?
  date                DateTime
  duration            Int?
  status              String             @default("scheduled") // scheduled, in_progress, awaiting_report, completed, cancelled, rescheduled
  completionDataJson  Json?
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tenantId])
  @@index([projectId])
  @@index([tenantId, date])
  // Calendarul per tehnician: acoperă ambele ramuri ale filtrului de vizibilitate
  // („atribuite mie" și „nerepartizate"), plus fereastra de căutare a suprapunerilor.
  @@index([tenantId, employeeId, date])
  @@index([clientId, type, status])
  @@index([installationId])
  @@index([vehicleId])
  @@index([deletedAt])
}

// ─── Email Inboxes (OAuth2 config for email ingestion) ─────────────────────

model EmailInbox {
  id             String    @id @default(cuid())
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  label          String
  email          String
  provider       String    @default("gmail")
  refreshToken   String?
  accessToken    String?
  tokenExpiresAt DateTime?
  purpose        String    @default("revision_import")
  isActive       Boolean   @default(true)
  lastPolledAt   DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([isActive])
}

// ─── Registry (registratură intrări/ieșiri documente) ─────────────────────

model RegistrySeries {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  code           String
  name           String
  direction      String   @default("INTERNAL") // IN, OUT, INTERNAL
  prefix         String?
  startingNumber Int      @default(1) // first number assigned for a new year
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries RegistryEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model RegistryEntry {
  id       String         @id @default(cuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  seriesId String
  series   RegistrySeries @relation(fields: [seriesId], references: [id])

  number        Int
  year          Int
  displayNumber String

  subject         String
  description     String?
  counterpartName String?
  fileS3Key       String?

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id])

  status     String    @default("active") // active, voided
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("RegistryVoider", fields: [voidedById], references: [id])
  voidReason String?

  createdAt        DateTime @default(now())
  createdById      String
  createdBy        User     @relation("RegistryCreator", fields: [createdById], references: [id])
  isManualOverride Boolean  @default(false)
  overrideReason   String?

  @@unique([tenantId, seriesId, year, number])
  @@index([tenantId, year])
  @@index([seriesId])
  @@index([documentId])
}

// ─── Email Ingest Logs (reconciliere PDF-uri) ─────────────────────────────

model EmailIngestLog {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  inboxId        String
  emailMessageId String
  emailFrom      String?
  emailSubject   String?
  emailDate      DateTime?
  fileName       String?
  s3Key          String?

  status String @default("pending") // pending, processing, completed, failed, needs_review

  parsedClientName      String?
  parsedClientSurname   String?
  parsedClientPhone     String?
  parsedClientEmail     String?
  parsedEquipmentName   String?
  parsedEquipmentSerial String?
  parsedData            Json?

  matchedClientId      String?
  matchedEquipmentId   String?
  matchedRevisionId    String?
  matchedAppointmentId String?

  resolvedClientId String?
  resolvedById     String?
  resolvedAt       DateTime?
  resolvedNotes    String?

  errorMessage String?
  errorStep    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([emailMessageId])
}
