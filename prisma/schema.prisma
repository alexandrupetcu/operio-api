generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenancy

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  cui       String?
  regCom    String?
  countryId Int?
  country   Country? @relation(fields: [countryId], references: [id])
  stateId   Int?
  state     State?   @relation(fields: [stateId], references: [id])
  cityId    Int?
  city      City?    @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  clients           Client[]
  projects          Project[]
  documents         Document[]
  documentTemplates DocumentTemplate[]
  services          Service[]
  employees         Employee[]
  vehicles          Vehicle[]
  workflowTemplates WorkflowTemplate[]
  actionPlans       ActionPlan[]

  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  documents     Document[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// Business domain

enum ClientType {
  PERSON
  COMPANY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  type      ClientType
  status    ClientStatus @default(ACTIVE)

  // Company fields
  companyName String?
  cui         String?

  // Person fields
  firstName String?
  lastName  String?

  // Common fields
  address    String
  countryId  Int?
  country    Country?  @relation(fields: [countryId], references: [id])
  stateId    Int?
  state      State?    @relation(fields: [stateId], references: [id])
  cityId     Int?
  city       City?     @relation(fields: [cityId], references: [id])
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  projects       Project[]
  contactPersons ContactPerson[]
  equipment      Equipment[]

  @@index([tenantId])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
}

model ContactPerson {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

enum EquipmentType {
  CENTRALA
}

model Equipment {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      EquipmentType @default(CENTRALA)
  name      String
  fuel      String?
  serial    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
}

model Project {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id])
  type      ProjectType
  name      String
  address   String
  city      String
  county    String
  observations       String?
  status             ProjectStatus @default(DRAFT)
  metadata           Json?
  scheduledDate      DateTime?
  assignedEmployeeId String?
  assignedEmployee   Employee?     @relation(fields: [assignedEmployeeId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  documents  Document[]
  actionPlan ActionPlan?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([clientId])
}

enum ProjectType {
  BRANSAMENT
  CONDUCTA
  REVIZIE_CENTRALA
  DOSAR_ISCIR
}

enum ProjectStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  DOCUMENTS_PENDING
  SUBMITTED
  APPROVED
  COMPLETED
  REJECTED
}

model DocumentTemplate {
  id          String           @id @default(cuid())
  tenantId    String?
  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  category    DocumentCategory
  name        String
  description String?
  content     String?          @db.Text
  s3Key       String?
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  documents Document[]

  @@index([tenantId, category])
}

enum DocumentCategory {
  CARTE_BRANSAMENT
  CARTE_CONDUCTA
  DOSAR_ISCIR
  REVIZIE_CENTRALA
  GDPR
  SERVICE_AGREEMENT
}

model Document {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id])
  templateId    String?
  template      DocumentTemplate? @relation(fields: [templateId], references: [id])
  generatedById String?
  generatedBy   User?          @relation(fields: [generatedById], references: [id])
  name          String
  s3Key         String?
  status        DocumentStatus @default(PENDING)
  errorMessage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([projectId])
  @@index([tenantId, status])
}

enum DocumentStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  UPLOADED
}

model Vehicle {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  licensePlate    String
  make            String
  model           String
  year            Int?
  vin             String?
  fuelType        String?
  insuranceExpiry DateTime?
  itpExpiry       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
}

model Employee {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  firstName   String
  lastName    String
  position    String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@index([tenantId])
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  unit        String?
  price       Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

// Geography (countries, states, cities)

model Country {
  id            Int     @id
  name          String
  iso3          String  @unique @db.Char(3)
  iso2          String  @unique @db.Char(2)
  numericCode   String?
  phonecode     String?
  capital       String?
  currency      String?
  currencyName  String?
  currencySymbol String?
  tld           String?
  native        String?
  region        String?
  subregion     String?
  nationality   String?
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  emoji         String?
  emojiU        String?

  states  State[]
  cities  City[]
  clients Client[]
  tenants Tenant[]

  @@index([name])
}

model State {
  id          Int     @id
  name        String
  countryId   Int
  country     Country @relation(fields: [countryId], references: [id])
  countryCode String  @db.Char(2)
  stateCode   String?
  type        String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)

  cities  City[]
  clients Client[]
  tenants Tenant[]

  @@index([countryId])
  @@index([name])
}

model City {
  id          Int     @id
  name        String
  stateId     Int
  state       State   @relation(fields: [stateId], references: [id])
  countryId   Int
  country     Country @relation(fields: [countryId], references: [id])
  countryCode String  @db.Char(2)
  stateCode   String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)

  clients Client[]
  tenants Tenant[]

  @@index([stateId])
  @@index([countryId])
  @@index([name])
}

// Workflow & Action Plans

model WorkflowTemplate {
  id          String       @id @default(cuid())
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  projectType ProjectType
  name        String
  description String?
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  steps       WorkflowTemplateStep[]
  actionPlans ActionPlan[]

  @@index([tenantId, projectType])
}

model WorkflowTemplateStep {
  id                  String           @id @default(cuid())
  templateId          String
  template            WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sortOrder           Int
  name                String
  description         String?
  institution         String?
  estimatedDays       Int              @default(30)
  requiredDocuments   String[]
  dependsOnStepOrder  Int?
  isSelectable        Boolean          @default(false)
  isSelectedByDefault Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([templateId])
}

enum ActionTaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  COMPLETED
  SKIPPED
}

model ActionPlan {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  projectId  String            @unique
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId String?
  template   WorkflowTemplate? @relation(fields: [templateId], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  tasks ActionTask[]

  @@index([tenantId])
}

model ActionTask {
  id              String           @id @default(cuid())
  actionPlanId    String
  actionPlan      ActionPlan       @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  sortOrder       Int
  name            String
  description     String?
  institution     String?
  status          ActionTaskStatus @default(TODO)
  estimatedDays   Int?
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  notes           String?          @db.Text
  dependsOnTaskId String?
  dependsOnTask   ActionTask?      @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependentTasks  ActionTask[]     @relation("TaskDependency")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([actionPlanId])
  @@index([dueDate])
  @@index([status])
}
