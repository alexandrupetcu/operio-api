# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Web app origin (CORS). Production: https://app.<domain>
FRONTEND_URL=http://localhost:5173

# ── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://operio:operio@localhost:5433/operio
REDIS_URL=redis://localhost:6380

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-min-10-chars
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Object storage (S3-compatible: MinIO / R2 / AWS) ─────────────────────────
# S3_ENDPOINT must be reachable by browsers/phones — presigned download URLs
# embed this host. Leave empty for AWS S3.
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=operio-documents
S3_REGION=us-east-1

# ── Email (optional — unset SMTP_HOST disables sending) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@operio.app

# ── Gmail inbox ingestion (optional, OAuth2 app credentials) ─────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_POLL_INTERVAL_MS=1200000

# ── Web push (optional). Generate ONCE with: npx web-push generate-vapid-keys
# Keep the pair stable across deploys or every browser subscription dies.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@operio.app

# ── AI features (optional) ───────────────────────────────────────────────────
OPENAI_API_KEY=
