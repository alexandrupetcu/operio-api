# Database
DATABASE_URL=postgresql://operio:operio_dev@localhost:5432/operio

# Redis
REDIS_URL=redis://localhost:6380

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
