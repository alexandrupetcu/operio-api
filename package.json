{
  "name": "operio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/app.ts",
    "check:instalatie-docs": "tsx scripts/check-instalatie-report-data.ts",
    "check:appt-scope": "tsx scripts/check-appointment-scope.ts",
    "check:appt-overlap": "tsx scripts/check-appointment-overlap.ts",
    "check:calendar-scoping": "tsx --env-file=.env scripts/check-calendar-scoping.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/app.js",
    "start:workers": "WORKERS_FROM_DIST=1 node scripts/run-workers.mjs",
    "worker": "tsx --env-file=.env src/workers/document-generation.worker.ts",
    "worker:revisions": "tsx --env-file=.env src/workers/revision-processing.worker.ts",
    "worker:signing": "tsx --env-file=.env src/workers/signing-complete.worker.ts",
    "worker:email-ingestion": "tsx --env-file=.env src/workers/email-ingestion.worker.ts",
    "worker:notifications": "tsx --env-file=.env src/workers/notification-scanner.worker.ts",
    "worker:workflow": "tsx --env-file=.env src/workers/workflow-engine.worker.ts",
    "workers": "node scripts/run-workers.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@bull-board/api": "^6.20.6",
    "@bull-board/fastify": "^6.20.6",
    "@bull-board/ui": "^6.20.6",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/sensible": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.0.0",
    "docxtemplater": "^3.50.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "googleapis": "^171.4.0",
    "nodemailer": "^8.0.5",
    "openai": "^6.27.0",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.1.0",
    "puppeteer": "^24.40.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/sharp": "^0.31.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
