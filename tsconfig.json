{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  // Testele nu intră în `dist` (build-ul e cel care rulează în producție).
  // Sunt verificate de tipuri separat, cu `tsconfig.test.json` — vezi `npm run typecheck`.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test/**"]
}
